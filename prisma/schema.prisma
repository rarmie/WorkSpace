generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus{
  WISHLIST 
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ConcernStatus{
  OPEN
  IN_REVIEW
  RESOLVED
}

// Written by the discovery pipeline (pipeline/publish.py), not the app.
// The app only reads this table; see docs/discovery-plan.md Phase 5.
model DiscoveredPosting {
  id           String    @id @default(cuid())
  source       String
  sourceId     String
  company      String
  role         String
  level        String?
  location     String
  isRemote     Boolean
  regions      String[]  @default([])
  url          String
  requirements String[]  @default([])
  postedAt     DateTime?
  firstSeenAt  DateTime
  closedAt     DateTime?

  // Back-relations, so the feed can filter with `none: { userId }`. They are Prisma-only: the
  // foreign keys live on JobApplication and DismissedPosting, so the pipeline's table is untouched.
  jobs         JobApplication[]
  dismissals   DismissedPosting[]

  @@unique([source, sourceId])
}

// A posting the user hid from their discovery feed. One row per user and posting; Undo deletes it.
model DismissedPosting {
  id        String   @id @default(cuid())
  userId    String
  postingId String
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posting DiscoveredPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@unique([userId, postingId])
}

enum WorkArrangement{
  REMOTE
  HYBRID
  ONSITE
}

enum Seniority{
  INTERN
  JUNIOR
  MID
  SENIOR
}

enum ApplicationSource{
  LINKEDIN
  INDEED
  JOBSTREET
  COMPANY_SITE
  REFERRAL
  OTHER
}

model JobApplication {
  id String @id @default(cuid())
  userId String 
  company String
  role String 
  status ApplicationStatus @default(APPLIED)
  appliedAt DateTime?
  link String?
  salary String?
  notes String?
  requirements String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matchScore Int?
  matchVerdicts Json?
  matchSummary String?
  matchedAt DateTime?
  source ApplicationSource?
  nextAction String?
  nextActionAt DateTime?
  // The discovery posting this job was saved from. Null for jobs added by hand.
  postingId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: if the pipeline ever deletes a posting, the saved job stays.
  posting DiscoveredPosting? @relation(fields: [postingId], references: [id], onDelete: SetNull)

  contacts Contact[]
  documents Document[]

  // Postgres treats NULLs as distinct, so any number of hand-added jobs (postingId null) never
  // clash. A real posting can be saved once per user: a second Save is a P2002 -> 409.
  @@unique([userId, postingId])
}

model Contact{
  id String @id @default(cuid())
  name String
  email String?
  role String?
  notes String?
  jobApplicationId String
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Document{
  id String @id @default(cuid())
  label String
  fileUrl String
  jobApplicationId String
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}

model Concern{
  id String @id @default(cuid())
  userId String?
  name String
  email String
  message String @db.Text
  status ConcernStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime?
  resolvedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model User{
  id String @id @default(cuid())
  email String @unique
  emailVerified DateTime?
  name String?
  password String?
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  resume String?
  resumeUpdatedAt DateTime?
  // Job-feed preferences (docs/discovery-plan.md Phase 7b). Empty or null means "no preference".
  targetRoles String[] @default([])
  country String?
  workArrangements WorkArrangement[] @default([])
  remoteRegions String[] @default([])
  seniority Seniority?
  skills String[] @default([])
  attributesUpdatedAt DateTime?

  applications JobApplication[]
  dismissedPostings DismissedPosting[]
  concerns Concern[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime

  @@unique([identifier, token])
}
